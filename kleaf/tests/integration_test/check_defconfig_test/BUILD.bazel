load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//build/kernel/kleaf:kernel.bzl", "kernel_build")
load("//build/kernel/kleaf/tests/utils:contain_lines_test.bzl", "contain_lines_test")

# b/505894708: Test that check_defconfig=match checks against inherited defconfig
write_file(
    name = "gki_defconfig_has_39_test_expected",
    out = "gki_defconfig_has_39/gki_defconfig",
    content = [
        "CONFIG_ARM64_VA_BITS_39=y",
        "",
    ],
)

contain_lines_test(
    name = "gki_defconfig_has_39_test",
    actual = "//common:arch/arm64/configs/gki_defconfig",
    expected = ":gki_defconfig_has_39_test_expected",
)

kernel_build(
    name = "match_against_inhertied_defconfig_kernel",
    srcs = ["//common:kernel_aarch64_sources"],
    outs = ["fake"],
    base_kernel = "//common:kernel_aarch64",
    check_defconfig = "match",
    make_goals = ["fake"],
    makefile = "//common:Makefile",
    pahole = "//common:pahole",
    # Setting 64K page size implicitly changes VA_BITS to 42, which triggers the build error.
    pre_defconfig_fragments = ["64k_config"],
    tags = ["manual"],
)
