load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_module",
    "kunit_test",
)
load("@rules_devicetree//devicetree:dtbo.bzl", "dtbo")

ddk_module(
    name = "x86_64_kunit_example_module",
    srcs = ["mod.c"],
    out = "mod.ko",
    kernel_build = "@kleaf//common:kernel_x86_64",
)

kunit_test(
    name = "x86_64_kunit_example_test",
    modules = [":x86_64_kunit_example_module"],
    tags = ["external"],
    test_name = "ddk-example",
    visibility = ["//build/kernel/kleaf/tests/kunit_examples:__pkg__"],
    deps = ["@kleaf//common:kunit_parser"],
)

dtbo(
    name = "x86_64_foo_dt",
    srcs = ["x86_64_foo_dt.dtso"],
)

ddk_module(
    name = "x86_64_kunit_example_module_with_dtbo",
    srcs = [
        "mod.c",
        ":x86_64_foo_dt",
    ],
    out = "x86_64_kunit_example_module_with_dtbo.ko",
    kernel_build = "@kleaf//common:kernel_x86_64",
    visibility = ["//build/kernel/kleaf/tests/kunit_examples:__pkg__"],
)
