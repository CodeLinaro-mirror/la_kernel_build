load("@bazel_skylib//rules:build_test.bzl", "build_test")
load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_library",
    "ddk_module",
)

ddk_module(
    name = "parent",
    srcs = ["parent.c"],
    out = "parent.ko",
    hdrs = ["parent.h"],
    includes = ["."],
    kernel_build = "@kleaf//common:kernel_aarch64",
    tags = ["manual"],
    visibility = ["//visibility:private"],
)

ddk_library(
    name = "lib_a",
    srcs = ["lib_a.c"],
    hdrs = ["lib_a.h"],
    includes = ["."],
    kernel_build = "@kleaf//common:kernel_aarch64",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [":parent"],
)

ddk_library(
    name = "lib_b",
    srcs = ["lib_b.c"],
    hdrs = ["lib_b.h"],
    includes = ["."],
    kernel_build = "@kleaf//common:kernel_aarch64",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [":parent"],
)

ddk_module(
    name = "child",
    srcs = ["child.c"],
    out = "child_mod.ko",
    kernel_build = "@kleaf//common:kernel_aarch64",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [":lib_a"],
)

ddk_module(
    name = "child_with_parent",
    srcs = ["child_with_parent.c"],
    out = "child_with_parent_mod.ko",
    kernel_build = "@kleaf//common:kernel_aarch64",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [
        ":lib_a",
        ":parent",
    ],
)

ddk_module(
    name = "child_diamond",
    srcs = ["child_diamond.c"],
    out = "child_diamond_mod.ko",
    kernel_build = "@kleaf//common:kernel_aarch64",
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = [
        ":lib_a",
        ":lib_b",
    ],
)

build_test(
    name = "ddk_library_module_deps",
    targets = [
        ":child",
        ":child_diamond",
        ":child_with_parent",
    ],
    visibility = ["//build/kernel/kleaf:__subpackages__"],
)
