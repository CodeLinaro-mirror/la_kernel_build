load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_headers",
    "ddk_module",
)

package(default_visibility = [
    "//build/kernel/kleaf/tests/ddk_examples/ddk_prebuilt_module:__subpackages__",
])

ddk_module(
    name = "parent",
    srcs = ["parent.c"],
    out = "parent.ko",
    kernel_build = "@kleaf//common:kernel_aarch64",
    deps = [":parent_hdrs"],
)

ddk_headers(
    name = "parent_hdrs",
    hdrs = ["parent.h"],
    includes = ["."],
)
