load("@bazel_skylib//rules:select_file.bzl", "select_file")
load(
    "@kleaf//build/kernel/kleaf:kernel.bzl",
    "ddk_module",
    "ddk_prebuilt_module",
    "kernel_module_group",
)

select_file(
    name = "parent_ko",
    srcs = "//build/kernel/kleaf/tests/ddk_examples/ddk_prebuilt_module/parent",
    subpath = "parent.ko",
)

select_file(
    name = "parent_symvers",
    srcs = "//build/kernel/kleaf/tests/ddk_examples/ddk_prebuilt_module/parent",
    subpath = "parent_Module.symvers",
)

ddk_prebuilt_module(
    name = "parent",
    src = ":parent_ko",
    hdrs = [
        "//build/kernel/kleaf/tests/ddk_examples/ddk_prebuilt_module/parent:parent_hdrs",
    ],
    includes = ["."],
    module_symvers = ":parent_symvers",
)

ddk_module(
    name = "child",
    srcs = ["child.c"],
    out = "child.ko",
    kernel_build = "@kleaf//common:kernel_aarch64",
    deps = [
        ":parent",
    ],
)

kernel_module_group(
    name = "ddk_prebuilt_module_sample",
    srcs = [
        ":child",
        ":parent",
    ],
)
