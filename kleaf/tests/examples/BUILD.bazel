"""Miscellaneous build tests showcasing ad-hoc targets."""

load("@bazel_skylib//rules:build_test.bzl", "build_test")

# Example on how to execute bindgen tool from a genrule.
genrule(
    name = "simple_bindgen_version",
    outs = ["bindgen_version.txt"],
    cmd = "$(execpath //build/kernel:bindgen) --version > $@",
    tools = [
        "//build/kernel:bindgen",
    ],
)

build_test(
    name = "examples_test",
    targets = [
        ":simple_bindgen_version",
    ],
)
