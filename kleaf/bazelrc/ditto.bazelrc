# --config=ditto: Internal config for building dittosuite

# Allow accessing the Internet for Protobuff, GoogleTest, etc.
common:ditto --config=internet

# Control auto-load modules
common:ditto --incompatible_autoload_externally=@rules_python,+java_common,+JavaInfo,+JavaPluginInfo,java_binary,-@protobuf,-@com_google_protobuf
# See bazel.py for additional flags.

# Restore BCR for Bazel to be able to find dependencies.
common:ditto --registry=https://bcr.bazel.build

# Set path to dittosuite project
common:ditto --override_module=dittosuite=test/dittosuite
