build:gbl --@rules_rust//rust/settings:toolchain_generated_sysroot=false
common:gbl --extra_toolchains=@gbl//toolchain:all
test:gbl  --test_output=errors

common:gbl --incompatible_autoload_externally=-@rules_python,-@rules_shell,-@rules_android,-@rules_java,-@protobuf,-@com_google_protobuf
common:gbl -c opt
common:gbl --override_module=gbl=%workspace%/bootable/libbootloader/gbl
common:gbl --override_module=apple_support=%workspace%/bootable/libbootloader/gbl/fake_modules/apple_support
common:gbl --override_module=googletest=%workspace%/external/googletest
common:gbl --override_module=rules_rust_bindgen=%workspace%/external/bazelbuild-rules_rust/extensions/bindgen

build:gbl --workspace_status_command=bootable/libbootloader/gbl/toolchain/workspace_status.sh
