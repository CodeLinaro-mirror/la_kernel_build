# --config=abfs: Experimental. Necessary when building with ABFS.

# These need to be set in the command line
# startup --digest_function=GITSHA1
# startup --unix_digest_hash_attribute_name=user.casfs_bin_hash

build:abfs --remote_cache=
build:abfs --no@kleaf//build/kernel/kleaf/impl:check_sandbox_in_actions
build:abfs --nohermetic_tools_use_symlinks
