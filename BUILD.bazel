load("@bazel_skylib//lib:paths.bzl", "paths")
load("@bazel_skylib//rules:native_binary.bzl", "native_binary")
load("@rules_pkg//pkg:tar.bzl", "pkg_tar")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")
load("@rules_shell//shell:sh_library.bzl", "sh_library")
load("//build/kernel/kleaf:hermetic_tools.bzl", "hermetic_tools")
load("//build/kernel/kleaf/impl:bison_flex_wrapper.bzl", "bison_flex_wrapper")
load("//build/kernel/kleaf/impl:executable_dispatcher.bzl", "executable_dispatcher")
load("//build/kernel/kleaf/impl:swig_wrapper.bzl", "swig_wrapper")

executable_dispatcher(
    name = "rsync",
    src = "@kleaf_host_tools//:rsync",
    append_args = ["--no-group"],
    visibility = ["//visibility:private"],
)

native_binary(
    name = "toybox",
    src = "@toybox",
    data = [
        # Prevents --notoolchain_from_sources from being set, and print a nice error message if so.
        "//build/kernel/kleaf:toolchain_from_sources",
        # Prevents --workaround_btrfs_b292212788 from being set, and print a nice error message if so.
        "//build/kernel/kleaf:workaround_btrfs_b292212788",
        # Prevents --debug_cache_dir_conflict from being set, and print a nice error message if so.
        "//build/kernel/kleaf:debug_cache_dir_conflict",
    ],
    visibility = ["//visibility:private"],
)

native_binary(
    name = "gzip",
    src = "@pigz",
    # Prevents --nogzip_is_pigz from being set, and print a nice error message if so.
    data = ["//build/kernel/kleaf:gzip_is_pigz"],
    visibility = ["//visibility:private"],
)

executable_dispatcher(
    name = "tar",
    src = ":toybox",
    append_args = [
        "--mtime=@0",
        "--owner=0",
        "--group=0",
        "--numeric-owner",
        "--sort=name",
    ],
    visibility = ["//visibility:private"],
)

# Also used in bootstrap_hermetic_tools, so use a native_binary to ensure
# the name of the binary is correct.
native_binary(
    name = "sed",
    src = ":toybox",
    out = "sed",
    visibility = ["//build/kernel/kleaf/bootstrap_hermetic_tools:__pkg__"],
)

bison_flex_wrapper(
    name = "bison",
    actual = "//prebuilts/build-tools:bison",
    m4 = "//prebuilts/build-tools:m4",
    pkgdata_dir = "//prebuilts/build-tools:bison.runfiles_dir",
    pkgdata_files = "//prebuilts/build-tools:bison.runfiles",
    visibility = ["//build/kernel/kleaf/bootstrap_hermetic_tools:__pkg__"],
)

bison_flex_wrapper(
    name = "flex",
    actual = "//prebuilts/build-tools:flex",
    m4 = "//prebuilts/build-tools:m4",
    visibility = ["//build/kernel/kleaf/bootstrap_hermetic_tools:__pkg__"],
)

swig_wrapper(
    name = "swig",
    src = "//prebuilts/kernel-build-tools:swig",
    swig_lib = "//prebuilts/kernel-build-tools:swig_lib_dir",
    visibility = ["//visibility:private"],
)

native_binary(
    name = "lz4",
    src = "@lz4",
    # Prevents --notoolchain_from_sources from being set, and print a nice error message if so.
    data = ["//build/kernel/kleaf:toolchain_from_sources"],
    visibility = ["//visibility:private"],
)

alias(
    name = "depmod",
    actual = select({
        "//build/kernel/kleaf:depmod_from_sources_is_true": "@kmod//:depmod",
        "//conditions:default": "//prebuilts/kernel-build-tools:depmod",
    }),
    visibility = ["//visibility:private"],
)

alias(
    name = "dtc",
    actual = select({
        "//build/kernel/kleaf:dtc_from_sources_is_true": "@dtc",
        "//conditions:default": "//prebuilts/kernel-build-tools:dtc",
    }),
    visibility = ["//visibility:private"],
)

